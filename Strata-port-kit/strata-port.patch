+/// fp16 -> fp32 by integer arithmetic (no F16C): the same decode expert.cpp and q2_avx2.cpp do, so a portable
+/// fallback produces the same scale value.
+inline float w2f(const uint8_t* p) {
+    uint16_t h;
+    std::memcpy(&h, p, 2);
+    const uint32_t sign = (uint32_t) (h >> 15) & 1u;
+    uint32_t exp = (h >> 10) & 0x1Fu, man = h & 0x3FFu, f;
+    if (exp == 0) {
+        if (man == 0) {
+            f = sign << 31;
+        } else {
+            exp = 127 - 15 + 1;
+            while (!(man & 0x400u)) { man <<= 1; --exp; }
+            man &= 0x3FFu;
+            f = (sign << 31) | (exp << 23) | (man << 13);
+        }
+    } else if (exp == 31) {
+        f = (sign << 31) | 0x7F800000u | (man << 13);
+    } else {
+        f = (sign << 31) | ((exp - 15 + 127) << 23) | (man << 13);
+    }
+    float out;
+    std::memcpy(&out, &f, 4);
+    return out;
+}
+
+/// The activation quantizer the AVX-512 and AVX-2 paths are the bit-for-bit scalar rule of: `QKA` values per
+/// chunk, an fp32 scale `amax / 127`, round half AWAY from zero by truncation, clamped to +-127, `hx = scale *
+/// sum`.  Portable, for a CPU without AVX2.
+void act_quant_scalar(const float* x, int n, ActQ& a) {
+    a.nchunks = n / QKA;
+    for (int k = 0; k < a.nchunks; ++k) {
+        const float* xb = x + k * QKA;
+        float amax = 0.f;
+        for (int j = 0; j < QKA; ++j) amax = std::fmax(amax, std::fabs(xb[j]));
+        const float s = amax > 0.f ? amax / 127.f : 0.f;
+        const float inv = s > 0.f ? 1.f / s : 0.f;
+        int32_t sum = 0;
+        int8_t* q = a.q + k * QKA;
+        for (int j = 0; j < QKA; ++j) {
+            const float t = xb[j] * inv;
+            const float r = t + (t >= 0.f ? 0.5f : -0.5f);
+            int v = (int) r;
+            v = v < -127 ? -127 : (v > 127 ? 127 : v);
+            q[j] = (int8_t) v;
+            sum += v;
+        }
+        a.scale[k] = s;
+        a.sum[k] = sum;
+        a.hx[k] = s * (float) sum;
+    }
+}
+
+/// One Q2_0 GGUF-layout row against `nt` activations, scalar.  Same identity the AVX kernels use: code `c` (0..3)
+/// against int8 `q`, minus the code-offset correction `hx`, per 32-value chunk and 64-weight block.
+void q2_rows_scalar(const uint8_t* w, size_t row_bytes, int nblocks, const ActQ* const* a, int nt,
+                    float* const* out, int r0, int r1) {
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* row = w + (size_t) r * row_bytes;
+        for (int t = 0; t < nt; ++t) {
+            const ActQ* act = a[t];
+            float acc = 0.f, corr = 0.f;
+            for (int b = 0; b < nblocks; ++b) {
+                const uint8_t* blk = row + (size_t) b * 18;
+                const float d = w2f(blk);
+                const uint8_t* codes = blk + 2;
+                const int8_t* q = act->q + b * QK;
+                for (int half = 0; half < 2; ++half) {
+                    int dot = 0;
+                    for (int j = 0; j < QKA; ++j)
+                        dot += ((codes[half * (QKA / 4) + (j >> 2)] >> (2 * (j & 3))) & 3) * (int) q[half * QKA + j];
+                    acc += d * act->scale[2 * b + half] * (float) dot;
+                }
+                corr += d * (act->hx[2 * b] + act->hx[2 * b + 1]);
+            }
+            out[t][r] = acc - corr;
+        }
+    }
+}
